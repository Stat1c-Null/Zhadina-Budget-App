modules = ["nodejs-22"]
run = "bash scripts/linux/dev.sh"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "autoscale"
build = ["bash", "scripts/linux/build.sh"]
run = ["bash", "scripts/linux/start.sh"]

# Only Next.js is public; the API stays on loopback (deployments allow one external port).
[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
